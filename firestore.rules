rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Bootstrap admins: only once they've verified they own the address, so nobody can
    // claim admin by signing up with an unregistered address. Keep in sync with
    // ADMIN_EMAILS in src/lib/auth.ts.
    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'admin@nuelsmart.com',
          'admin@nuels.com',
          'anirudhjyothula@gmail.com',
          'srikanth.nsws1@gmail.com'
        ];
    }

    // Admin = bootstrap admin, or someone an admin has given the admin role.
    function isAdmin() {
      return isBootstrapAdmin()
        || (signedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Company employees: an active "employee" account whose admin-granted permissions include p.
    function hasPerm(p) {
      return signedIn() && staffPerm(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, p);
    }
    function staffPerm(me, p) {
      return me.get('role', '') == 'employee' && me.get('status', 'active') == 'active' && p in me.get('permissions', []);
    }

    // Member IDs: "T" + 4 digits for tutors (or tutor applicants), "E" for employees, "S" for
    // everyone else, and reserved for this user in memberIds/{id} within the same write.
    function isTutorProfile(data) {
      return data.get('role', '') == 'mentor' || data.get('requestedRole', '') == 'mentor';
    }
    function memberIdPattern(data) {
      return data.get('role', '') == 'employee' ? '^E[0-9]{4}$' : isTutorProfile(data) ? '^T[0-9]{4}$' : '^S[0-9]{4}$';
    }
    function validMemberId(data) {
      return !('memberId' in data) || (
        data.memberId is string
        && data.memberId.matches(memberIdPattern(data))
        && getAfter(/databases/$(database)/documents/memberIds/$(data.memberId)).data.uid == request.auth.uid
      );
    }

    // Keep profiles small: the photo is a cropped 256px JPEG data URL.
    function validProfileFields(data) {
      return (!('photo' in data) || (data.photo is string && data.photo.size() < 200000 && data.photo.matches('^data:image/(jpeg|png|webp);base64,.*')))
        && (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 30))
        && (!('whatsappOptIn' in data) || data.whatsappOptIn is bool)
        && (!('whatsappWelcome' in data) || (resource != null && resource.data.get('whatsappWelcome', null) == data.whatsappWelcome))
        && (!('cart' in data) || (data.cart is list && data.cart.size() <= 20));
    }

    // Course slugs on an order: a non-empty, cart-sized list.
    function validCourseList(courses) {
      return courses is list && courses.size() > 0 && courses.size() <= 20;
    }

    match /users/{uid} {
      // Your own profile, any profile for admins, and mentor profiles for signed-in users.
      // Staff see students or fellow employees when their permissions allow it.
      allow get, list: if signedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || resource.data.role == 'mentor'
        || (resource.data.role == 'student' && (hasPerm('students.view') || hasPerm('learners.manage')))
        || (resource.data.role == 'employee' && hasPerm('staff.view'))
      );

      // Self sign-up always creates a student. Instructor applicants are stored with
      // requestedRole 'mentor' and stay students until an admin approves them.
      // Bootstrap admins may create their own profile as admin.
      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.email == request.auth.token.email
          && !('enrolledCourses' in request.resource.data)
          && validProfileFields(request.resource.data)
          && validMemberId(request.resource.data)
          && (
            (request.resource.data.role == 'student'
              && (!('requestedRole' in request.resource.data) || request.resource.data.requestedRole == 'mentor'))
            || (request.resource.data.role == 'admin' && isBootstrapAdmin())
          )
        );

      // Users may edit their own profile (including their cart) but never their role, email,
      // application, member ID, enrolled courses or staff details: only a confirmed payment
      // adds courses, and only admins change staff access.
      // The one exception: an older account without a member ID may claim one, once.
      allow update: if isAdmin()
        || (
          hasPerm('payments.approve')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledCourses', 'cart'])
        )
        || (
          signedIn()
          && request.auth.uid == uid
          && validProfileFields(request.resource.data)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'requestedRole', 'memberId', 'whatsappWelcome', 'enrolledCourses', 'designation', 'employeeNumber', 'permissions', 'status', 'joinDate'])
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberId'])
              && !('memberId' in resource.data)
              && validMemberId(request.resource.data)
            )
          )
        );

      allow delete: if isAdmin();
    }

    match /memberIds/{id} {
      // Needed to check whether an ID is free; reveals only which account holds it.
      allow get: if signedIn();
      allow list: if isAdmin();

      // Reserve an ID only together with writing it onto your own profile (or, for admins,
      // onto the profile of the employee they're creating).
      allow create: if signedIn()
        && id.matches('^[STE][0-9]{4}$')
        && (request.resource.data.uid == request.auth.uid || isAdmin())
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.memberId == id;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // Course orders. Learners create pending orders and may cancel their own pending ones.
    // Only an admin (offline payments) or the verifyRazorpayPayment Cloud Function (which
    // bypasses these rules) can mark an order paid.
    match /orders/{orderId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || hasPerm('payments.view')
        || hasPerm('payments.approve');

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'memberId', 'courses', 'amount', 'method', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.method in ['razorpay', 'manual']
        && validCourseList(request.resource.data.courses)
        && request.resource.data.amount is number
        && request.resource.data.createdAt == request.time;

      // Learners may cancel a pending order, or attach a payment screenshot to an offline
      // order (which puts a rejected one back into review). Only admins and staff with the
      // "payments.approve" permission approve or reject.
      allow update: if isAdmin()
        || (
          hasPerm('payments.approve')
          && request.resource.data.status in ['paid', 'rejected', 'cancelled']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'confirmedBy', 'rejectReason', 'cancelledAt'])
        )
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        )
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.method == 'manual'
          && resource.data.status in ['pending', 'rejected']
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['screenshot', 'screenshotAt', 'paymentRef', 'status', 'rejectReason'])
          && request.resource.data.screenshot is string
          && request.resource.data.screenshot.size() < 900000
          && request.resource.data.screenshot.matches('^data:image/(jpeg|png|webp);base64,.*')
          && request.resource.data.screenshotAt == request.time
          && !('rejectReason' in request.resource.data)
          && (!('paymentRef' in request.resource.data) || (request.resource.data.paymentRef is string && request.resource.data.paymentRef.size() <= 40))
        );

      allow delete: if isAdmin();
    }

    function enrolledIn(slug) {
      return slug in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('enrolledCourses', []);
    }

    // A learner's record for one course, id "{uid}_{slug}". Learners write their own lesson
    // progress, assignment answers, interview requests and document checklist; attendance,
    // interview results and grades come only from admins.
    match /progress/{id} {
      function ownRecord() {
        return signedIn() && id.matches(request.auth.uid + '_[a-z0-9-]+');
      }
      function learnerKeys() {
        return ['uid', 'slug', 'completed', 'lastLesson', 'assignments', 'interviewRequest', 'docs', 'updatedAt'];
      }

      allow get: if isAdmin() || ownRecord() || hasPerm('learners.manage');
      allow list: if isAdmin() || hasPerm('learners.manage');

      allow create: if isAdmin()
        || (
          ownRecord()
          && request.resource.data.uid == request.auth.uid
          && id == request.auth.uid + '_' + request.resource.data.slug
          && enrolledIn(request.resource.data.slug)
          && request.resource.data.keys().hasOnly(learnerKeys())
          && (!('completed' in request.resource.data) || request.resource.data.completed.size() <= 300)
        );

      allow update: if isAdmin()
        || (
          hasPerm('learners.manage')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance', 'interviews', 'interviewRequest', 'grades'])
        )
        || (
          ownRecord()
          && enrolledIn(resource.data.slug)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(learnerKeys())
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.slug == resource.data.slug
          && (!('completed' in request.resource.data) || request.resource.data.completed.size() <= 300)
        );

      allow delete: if isAdmin();
    }

    // Lesson videos. Free previews are readable by any signed-in user; paid videos only by
    // learners enrolled in the course.
    // Mock tests from a stored question bank (free tier, no server code):
    //  - questionBanks/{slug}_{lessonId}: questions and options only, readable by enrolled learners
    //  - answerKeys/{slug}_{lessonId}:    correct answers and explanations, readable by a learner
    //                                     only after they've submitted that test
    //  - mockTests/{uid}_{slug}_{lessonId}: one attempt per learner; started on the server clock,
    //                                     submitted once within the time limit, and the score is
    //                                     re-checked here against the answer key
    match /questionBanks/{id} {
      allow get, list: if isAdmin() || hasPerm('courses.manage') || (signedIn() && enrolledIn(resource.data.slug));
      allow write: if isAdmin() || hasPerm('courses.manage');
    }

    match /answerKeys/{id} {
      allow get: if isAdmin()
        || hasPerm('courses.manage')
        || (signedIn()
            && exists(/databases/$(database)/documents/mockTests/$(request.auth.uid + '_' + id))
            && get(/databases/$(database)/documents/mockTests/$(request.auth.uid + '_' + id)).data.get('submittedAt', null) != null);
      allow write: if isAdmin() || hasPerm('courses.manage');
    }

    match /mockTests/{id} {
      function bankId(data) {
        return data.slug + '_' + data.lessonId;
      }
      function point(a, k, i) {
        return a[i] == k[i] ? 1 : 0;
      }
      function scoreOf(a, k) {
        return point(a, k, 0) + point(a, k, 1) + point(a, k, 2) + point(a, k, 3) + point(a, k, 4)
          + point(a, k, 5) + point(a, k, 6) + point(a, k, 7) + point(a, k, 8) + point(a, k, 9);
      }

      allow get, list: if isAdmin() || hasPerm('learners.manage') || (signedIn() && resource.data.uid == request.auth.uid);

      // Start: own attempt, enrolled, lesson finished, a question bank exists, server-clock start.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + bankId(request.resource.data)
        && request.resource.data.keys().hasOnly(['uid', 'slug', 'lessonId', 'startedAt'])
        && request.resource.data.startedAt == request.time
        && enrolledIn(request.resource.data.slug)
        && exists(/databases/$(database)/documents/questionBanks/$(bankId(request.resource.data)))
        && request.resource.data.lessonId in get(/databases/$(database)/documents/progress/$(request.auth.uid + '_' + request.resource.data.slug)).data.get('completed', []);

      // 1) Submit once. Within 10 minutes (+45 s grace) answers count; later, only a blank sheet is accepted.
      // 2) Then, once, the score: it must equal what the answer key gives for the saved answers.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && (
          (
            resource.data.get('submittedAt', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'total', 'submittedAt'])
            && request.resource.data.submittedAt == request.time
            && request.resource.data.answers is list
            && request.resource.data.answers.size() == 10
            && request.resource.data.total == 10
            && (request.time <= resource.data.startedAt + duration.value(645, 's') || request.resource.data.answers.hasOnly([null]))
          )
          || (
            resource.data.get('submittedAt', null) != null
            && !('score' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score'])
            && request.resource.data.score == scoreOf(
                 resource.data.answers,
                 get(/databases/$(database)/documents/answerKeys/$(bankId(resource.data))).data.answers)
          )
        );

      // Admins can reset an attempt so the learner can take it again.
      allow delete: if isAdmin() || hasPerm('learners.manage');
    }

    match /courseContent/{slug} {
      allow get: if signedIn();
      allow write: if isAdmin() || hasPerm('videos.manage');

      match /paid/{doc} {
        allow get: if isAdmin() || hasPerm('videos.manage') || (signedIn() && enrolledIn(slug));
        allow write: if isAdmin() || hasPerm('videos.manage');
      }
    }

    // The live course catalog: changes to built-in courses and admin-added courses. Public,
    // because course listings and prices show to visitors.
    match /catalog/{slug} {
      allow get, list: if true;
      allow write: if (isAdmin() || hasPerm('courses.manage'))
        && slug.matches('^[a-z0-9-]{1,60}$')
        && (!('price' in request.resource.data) || (request.resource.data.price is number && request.resource.data.price > 0));
    }

    // UPI and bank details shown at checkout.
    match /settings/payment {
      allow get: if signedIn();
      allow write: if isAdmin();
    }
  }
}
