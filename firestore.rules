rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Bootstrap admins: only once they've verified they own the address, so nobody can
    // claim admin by signing up with an unregistered address. Keep in sync with
    // ADMIN_EMAILS in src/lib/auth.ts.
    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'admin@nuelsmart.com',
          'admin@nuels.com',
          'anirudhjyothula@gmail.com',
          'srikanth.nsws1@gmail.com'
        ];
    }

    // Admin = bootstrap admin, or someone an admin has given the admin role.
    function isAdmin() {
      return isBootstrapAdmin()
        || (signedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active');
    }

    // Company employees: an active "employee" account whose admin-granted permissions include p.
    function hasPerm(p) {
      return signedIn() && staffPerm(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, p);
    }
    function staffPerm(me, p) {
      return me.get('role', '') == 'employee' && me.get('status', 'active') == 'active' && p in me.get('permissions', []);
    }

    // Member IDs: "T" + 4 digits for tutors (or tutor applicants), "E" for employees, "S" for
    // everyone else, and reserved for this user in memberIds/{id} within the same write.
    function isTutorProfile(data) {
      return data.get('role', '') == 'mentor' || data.get('requestedRole', '') == 'mentor';
    }
    function memberIdPattern(data) {
      return data.get('role', '') == 'employee' ? '^E[0-9]{4}$' : isTutorProfile(data) ? '^T[0-9]{4}$' : '^S[0-9]{4}$';
    }
    function validMemberId(data) {
      return !('memberId' in data) || (
        data.memberId is string
        && data.memberId.matches(memberIdPattern(data))
        && getAfter(/databases/$(database)/documents/memberIds/$(data.memberId)).data.uid == request.auth.uid
      );
    }

    // Keep profiles small: the photo is a cropped 256px JPEG data URL.
    function validProfileFields(data) {
      return (!('photo' in data) || (data.photo is string && data.photo.size() < 200000 && data.photo.matches('^data:image/(jpeg|png|webp);base64,.*')))
        && (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 30))
        && (!('whatsappOptIn' in data) || data.whatsappOptIn is bool)
        && (!('whatsappWelcome' in data) || (resource != null && resource.data.get('whatsappWelcome', null) == data.whatsappWelcome))
        && (!('cart' in data) || (data.cart is list && data.cart.size() <= 20))
        && (!('studyClass' in data) || (data.studyClass is string && data.studyClass.size() <= 20))
        && (!('quizGroup' in data) || (data.quizGroup is string && data.quizGroup.size() <= 8));
    }

    // Course slugs on an order: a non-empty, cart-sized list.
    function validCourseList(courses) {
      return courses is list && courses.size() > 0 && courses.size() <= 20;
    }

    match /users/{uid} {
      // Your own profile, any profile for admins, and mentor profiles for signed-in users.
      // Staff see students or fellow employees when their permissions allow it.
      allow get, list: if signedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || resource.data.role == 'mentor'
        || (resource.data.role == 'student' && (hasPerm('students.view') || hasPerm('learners.manage')))
        || (resource.data.role == 'employee' && hasPerm('staff.view'))
      );

      // Self sign-up always creates a student. Instructor applicants are stored with
      // requestedRole 'mentor' and stay students until an admin approves them.
      // Bootstrap admins may create their own profile as admin.
      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.email == request.auth.token.email
          && !('enrolledCourses' in request.resource.data)
          && validProfileFields(request.resource.data)
          && validMemberId(request.resource.data)
          && (!('quizGroup' in request.resource.data) || validQuizGroup(request.resource.data.quizGroup))
          && (
            (request.resource.data.role == 'student'
              && (!('requestedRole' in request.resource.data) || request.resource.data.requestedRole == 'mentor'))
            || (request.resource.data.role == 'admin' && isBootstrapAdmin())
          )
        );

      // Users may edit their own profile (including their cart) but never their role, email,
      // application, member ID, enrolled courses or staff details: only a confirmed payment
      // adds courses, and only admins change staff access.
      // The one exception: an older account without a member ID may claim one, once.
      allow update: if isAdmin()
        || (
          hasPerm('payments.approve')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledCourses', 'cart'])
        )
        || (
          signedIn()
          && request.auth.uid == uid
          && validProfileFields(request.resource.data)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'requestedRole', 'memberId', 'whatsappWelcome', 'enrolledCourses', 'designation', 'employeeNumber', 'permissions', 'status', 'joinDate', 'quizGroup', 'studyClass'])
            || (
              // Class (and with it the Daily Quiz group): chosen once by learners who registered
              // before sign-up asked for it. After that only an admin changes it.
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studyClass', 'quizGroup'])
              && !('studyClass' in resource.data)
              && request.resource.data.studyClass is string
              && validQuizGroup(request.resource.data.quizGroup)
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberId'])
              && !('memberId' in resource.data)
              && validMemberId(request.resource.data)
            )
          )
        );

      allow delete: if isAdmin();
    }

    match /memberIds/{id} {
      // Needed to check whether an ID is free; reveals only which account holds it.
      allow get: if signedIn();
      allow list: if isAdmin();

      // Reserve an ID only together with writing it onto your own profile (or, for admins,
      // onto the profile of the employee they're creating).
      allow create: if signedIn()
        && id.matches('^[STE][0-9]{4}$')
        && (request.resource.data.uid == request.auth.uid || isAdmin())
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.memberId == id;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // Course orders. Learners create pending orders and may cancel their own pending or rejected ones.
    // Only an admin (offline payments) or the verifyRazorpayPayment Cloud Function (which
    // bypasses these rules) can mark an order paid.
    match /orders/{orderId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || hasPerm('payments.view')
        || hasPerm('payments.approve');

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'memberId', 'courses', 'amount', 'method', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.method in ['razorpay', 'manual']
        && validCourseList(request.resource.data.courses)
        && request.resource.data.amount is number
        && request.resource.data.createdAt == request.time;

      // Learners may cancel a pending order, attach a payment screenshot to a pending offline order,
      // or dismiss the notice of a rejected one. A rejected order is closed (the learner orders
      // again). Only admins and staff with the "payments.approve" permission approve or reject.
      allow update: if isAdmin()
        || (
          hasPerm('payments.approve')
          && request.resource.data.status in ['paid', 'rejected', 'cancelled']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'confirmedBy', 'rejectReason', 'rejectedAt', 'cancelledAt'])
        )
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        )
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rejectionSeenAt'])
          && request.resource.data.rejectionSeenAt == request.time
        )
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.method == 'manual'
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['screenshot', 'screenshotAt', 'paymentRef', 'status', 'rejectReason'])
          && request.resource.data.screenshot is string
          && request.resource.data.screenshot.size() < 900000
          && request.resource.data.screenshot.matches('^data:image/(jpeg|png|webp);base64,.*')
          && request.resource.data.screenshotAt == request.time
          && !('rejectReason' in request.resource.data)
          && (!('paymentRef' in request.resource.data) || (request.resource.data.paymentRef is string && request.resource.data.paymentRef.size() <= 40))
        );

      allow delete: if isAdmin();
    }

    function enrolledIn(slug) {
      return slug in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('enrolledCourses', []);
    }

    // A learner's record for one course, id "{uid}_{slug}". Learners write their own lesson
    // progress, assignment answers, interview requests and document checklist; attendance,
    // interview results and grades come only from admins.
    match /progress/{id} {
      function ownRecord() {
        return signedIn() && id.matches(request.auth.uid + '_[a-z0-9-]+');
      }
      function learnerKeys() {
        return ['uid', 'slug', 'completed', 'lastLesson', 'assignments', 'interviewRequest', 'docs', 'updatedAt'];
      }

      allow get: if isAdmin() || ownRecord() || hasPerm('learners.manage');
      allow list: if isAdmin() || hasPerm('learners.manage');

      allow create: if isAdmin()
        || (
          ownRecord()
          && request.resource.data.uid == request.auth.uid
          && id == request.auth.uid + '_' + request.resource.data.slug
          && enrolledIn(request.resource.data.slug)
          && request.resource.data.keys().hasOnly(learnerKeys())
          && (!('completed' in request.resource.data) || request.resource.data.completed.size() <= 300)
        );

      allow update: if isAdmin()
        || (
          hasPerm('learners.manage')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance', 'interviews', 'interviewRequest', 'grades'])
        )
        || (
          ownRecord()
          && enrolledIn(resource.data.slug)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(learnerKeys())
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.slug == resource.data.slug
          && (!('completed' in request.resource.data) || request.resource.data.completed.size() <= 300)
        );

      allow delete: if isAdmin();
    }

    // Lesson videos. Free previews are readable by any signed-in user; paid videos only by
    // learners enrolled in the course.
    // Mock tests from a stored question bank (free tier, no server code):
    //  - questionBanks/{slug}_{lessonId}: questions and options only, readable by enrolled learners
    //  - answerKeys/{slug}_{lessonId}:    correct answers and explanations, readable by a learner
    //                                     only after they've submitted that test
    //  - mockTests/{uid}_{slug}_{lessonId}: one attempt per learner; started on the server clock,
    //                                     submitted once within the time limit, and the score is
    //                                     re-checked here against the answer key
    match /questionBanks/{id} {
      allow get, list: if isAdmin() || hasPerm('courses.manage') || (signedIn() && enrolledIn(resource.data.slug));
      allow write: if isAdmin() || hasPerm('courses.manage');
    }

    match /answerKeys/{id} {
      allow get: if isAdmin()
        || hasPerm('courses.manage')
        || (signedIn()
            && exists(/databases/$(database)/documents/mockTests/$(request.auth.uid + '_' + id))
            && get(/databases/$(database)/documents/mockTests/$(request.auth.uid + '_' + id)).data.get('submittedAt', null) != null);
      allow write: if isAdmin() || hasPerm('courses.manage');
    }

    match /mockTests/{id} {
      function bankId(data) {
        return data.slug + '_' + data.lessonId;
      }
      function point(a, k, i) {
        return a[i] == k[i] ? 1 : 0;
      }
      function scoreOf(a, k) {
        return point(a, k, 0) + point(a, k, 1) + point(a, k, 2) + point(a, k, 3) + point(a, k, 4)
          + point(a, k, 5) + point(a, k, 6) + point(a, k, 7) + point(a, k, 8) + point(a, k, 9);
      }

      // Ownership comes from the document id ({uid}_{course}_{lesson}), so a learner can also check for an
      // attempt that doesn't exist yet (reading resource.data of a missing document is always denied).
      allow get: if isAdmin() || hasPerm('learners.manage') || (signedIn() && id.matches(request.auth.uid + '_[a-z0-9-]+_m[0-9]+-l[0-9]+'));
      allow list: if isAdmin() || hasPerm('learners.manage') || (signedIn() && resource.data.uid == request.auth.uid);

      // Start: own attempt, enrolled, lesson finished, a question bank exists, server-clock start.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + bankId(request.resource.data)
        && request.resource.data.keys().hasOnly(['uid', 'slug', 'lessonId', 'startedAt'])
        && request.resource.data.startedAt == request.time
        && enrolledIn(request.resource.data.slug)
        && exists(/databases/$(database)/documents/questionBanks/$(bankId(request.resource.data)))
        && request.resource.data.lessonId in get(/databases/$(database)/documents/progress/$(request.auth.uid + '_' + request.resource.data.slug)).data.get('completed', []);

      // 1) Submit once. Within 10 minutes (+45 s grace) answers count; later, only a blank sheet is accepted.
      // 2) Then, once, the score: it must equal what the answer key gives for the saved answers.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && (
          (
            resource.data.get('submittedAt', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'total', 'submittedAt'])
            && request.resource.data.submittedAt == request.time
            && request.resource.data.answers is list
            && request.resource.data.answers.size() == 10
            && request.resource.data.total == 10
            && (request.time <= resource.data.startedAt + duration.value(645, 's') || request.resource.data.answers.hasOnly([null]))
          )
          || (
            resource.data.get('submittedAt', null) != null
            && !('score' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score'])
            && request.resource.data.score == scoreOf(
                 resource.data.answers,
                 get(/databases/$(database)/documents/answerKeys/$(bankId(resource.data))).data.answers)
          )
        );

      // Admins can reset an attempt so the learner can take it again.
      allow delete: if isAdmin() || hasPerm('learners.manage');
    }

    match /courseContent/{slug} {
      allow get: if signedIn();
      allow write: if isAdmin() || hasPerm('videos.manage');

      match /paid/{doc} {
        allow get: if isAdmin() || hasPerm('videos.manage') || (signedIn() && enrolledIn(slug));
        allow write: if isAdmin() || hasPerm('videos.manage');
      }
    }

    // The live course catalog: changes to built-in courses and admin-added courses. Public,
    // because course listings and prices show to visitors.
    match /catalog/{slug} {
      allow get, list: if true;
      allow write: if (isAdmin() || hasPerm('courses.manage'))
        && slug.matches('^[a-z0-9-]{1,60}$')
        && (!('price' in request.resource.data) || (request.resource.data.price is number && request.resource.data.price > 0));
    }

    // UPI and bank details shown at checkout.
    match /settings/payment {
      allow get: if signedIn();
      allow write: if isAdmin();
    }

    // ---------------- Contact page enquiries ----------------
    // Anyone (signed in or not) may send one well-formed message; only admins read and follow them up.
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'topic', 'message', 'status', 'uid', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200 && request.resource.data.email.matches('^[^@ ]+@[^@ ]+$')
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20))
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 60
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'new'
        && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == request.auth.uid))
        && request.resource.data.createdAt == request.time;
      allow get, list, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt', 'statusBy'])
        && request.resource.data.status in ['new', 'reviewed', 'contacted', 'registered', 'removed'];
    }

    // ---------------- Daily Quiz ----------------
    // India-time day number and minute of the day, from the server clock.
    function istMillis() {
      return request.time.toMillis() + 19800000;
    }
    function istDay() {
      return int(math.floor(istMillis() / 86400000));
    }
    function istMinute() {
      return int(math.floor((istMillis() % 86400000) / 60000));
    }
    // Open 5:00 AM to 7:00 PM India time.
    function quizWindowOpen() {
      return istMinute() >= 300 && istMinute() < 1140;
    }
    // Groups a learner can be placed in (src/data/quizPatterns.json, non-legacy). Each group's
    // sections and questions per section live in quizPaperKeys/{group}, written by the upload script.
    function validQuizGroup(g) {
      return g is string && g in ['K1', 'K2', 'K3', 'A', 'B', 'C', 'X', 'NAV', 'IMPC', 'IBPC', 'IDIP', 'IIIT', 'IOTH', 'NEET', 'EAM', 'PRO'];
    }

    // Questions (no answers): any signed-in user. Answer keys: admins only, except one answer at a
    // time for a question on the learner's own submitted paper from today or yesterday.
    match /quizBanks/{bankId} {
      allow get, list: if signedIn();
      allow write: if isAdmin() || hasPerm('courses.manage');
    }
    // Answer keys per group paper, used only by these rules to check scores.
    match /quizPaperKeys/{group} {
      allow get, list, write: if isAdmin() || hasPerm('courses.manage');
    }
    match /quizKeys/{bankId} {
      allow get, list: if isAdmin() || hasPerm('courses.manage');
      allow write: if isAdmin() || hasPerm('courses.manage');

      function revealable(day, n) {
        let path = /databases/$(database)/documents/dailyQuiz/$(request.auth.uid + '_' + string(day));
        return exists(path)
          && get(path).data.get('submittedAt', null) != null
          && int(n) in get(path).data.picks.get(bankId, []);
      }
      match /items/{n} {
        allow get: if isAdmin() || hasPerm('courses.manage')
          || (signedIn() && n.matches('^[0-9]{1,4}$') && (revealable(istDay(), n) || revealable(istDay() - 1, n)));
        allow list: if isAdmin() || hasPerm('courses.manage');
        allow write: if isAdmin() || hasPerm('courses.manage');
      }
    }

    // One paper per learner per India-time day: dailyQuiz/{uid}_{day}.
    match /dailyQuiz/{id} {
      function myPaper() {
        return signedIn() && id.matches(request.auth.uid + '_[0-9]+');
      }
      // Papers have up to 10 sections of 3 or 5 questions; rules can't loop, so each check is
      // written out per section and skipped past the last one. Sections are the paper's own picks.
      function pickList(p, ids, i, n) {
        return ids.size() <= i || (p[ids[i]] is list && p[ids[i]].size() == n);
      }
      // A new paper: exactly the group's sections, each with the group's number of questions.
      function validPicks(p, group) {
        let spec = get(/databases/$(database)/documents/quizPaperKeys/$(group)).data;
        let ids = spec.banks;
        let n = spec.perSection;
        return p.keys().hasOnly(ids) && p.keys().hasAll(ids)
          && pickList(p, ids, 0, n) && pickList(p, ids, 1, n) && pickList(p, ids, 2, n) && pickList(p, ids, 3, n) && pickList(p, ids, 4, n)
          && pickList(p, ids, 5, n) && pickList(p, ids, 6, n) && pickList(p, ids, 7, n) && pickList(p, ids, 8, n) && pickList(p, ids, 9, n);
      }
      // Every answer is 0-3, or null (unanswered); one per question on the paper.
      function answerList(a, p, ids, i) {
        return ids.size() <= i || (a[ids[i]] is list && a[ids[i]].size() == p[ids[i]].size() && a[ids[i]].hasOnly([0, 1, 2, 3, null]));
      }
      function validAnswers(a, p) {
        let ids = p.keys();
        return a.keys().hasOnly(ids) && a.keys().hasAll(ids)
          && answerList(a, p, ids, 0) && answerList(a, p, ids, 1) && answerList(a, p, ids, 2) && answerList(a, p, ids, 3) && answerList(a, p, ids, 4)
          && answerList(a, p, ids, 5) && answerList(a, p, ids, 6) && answerList(a, p, ids, 7) && answerList(a, p, ids, 8) && answerList(a, p, ids, 9);
      }
      function blank(a, ids, i) {
        return ids.size() <= i || a[ids[i]].hasOnly([null]);
      }
      function allBlank(a) {
        let ids = a.keys();
        return blank(a, ids, 0) && blank(a, ids, 1) && blank(a, ids, 2) && blank(a, ids, 3) && blank(a, ids, 4)
          && blank(a, ids, 5) && blank(a, ids, 6) && blank(a, ids, 7) && blank(a, ids, 8) && blank(a, ids, 9);
      }
      // The correct options for one section's picks, straight from the hidden key (k = that bank's answers).
      function keyFor(k, p) {
        return p.size() == 3 ? [k[p[0]], k[p[1]], k[p[2]]] : [k[p[0]], k[p[1]], k[p[2]], k[p[3]], k[p[4]]];
      }
      function pts(a, c) {
        return (a[0] == c[0] ? 1 : 0) + (a[1] == c[1] ? 1 : 0) + (a[2] == c[2] ? 1 : 0)
          + (a.size() == 5 ? (a[3] == c[3] ? 1 : 0) + (a[4] == c[4] ? 1 : 0) : 0);
      }
      function keyOk(d, c, k, ids, i) {
        return ids.size() <= i || c[ids[i]] == keyFor(k[ids[i]], d.picks[ids[i]]);
      }
      function secPts(d, c, ids, i) {
        return ids.size() <= i ? 0 : pts(d.answers[ids[i]], c[ids[i]]);
      }
      // Scoring is two writes (one check would exceed the rules' 1000-expression limit on a 30-question paper):
      // 2a) the correct options, matched against quizPaperKeys/{group} (one read for every bank on the paper);
      function checkedKey(d, c) {
        let ids = d.picks.keys();
        let k = get(/databases/$(database)/documents/quizPaperKeys/$(d.group)).data.answers;
        return c.keys().hasOnly(ids) && c.keys().hasAll(ids)
          && keyOk(d, c, k, ids, 0) && keyOk(d, c, k, ids, 1) && keyOk(d, c, k, ids, 2) && keyOk(d, c, k, ids, 3) && keyOk(d, c, k, ids, 4)
          && keyOk(d, c, k, ids, 5) && keyOk(d, c, k, ids, 6) && keyOk(d, c, k, ids, 7) && keyOk(d, c, k, ids, 8) && keyOk(d, c, k, ids, 9);
      }
      // 2b) the score, counted from the answers and the checked correct options.
      function checkedScore(d, score) {
        let ids = d.picks.keys();
        let c = d.correct;
        return score == secPts(d, c, ids, 0) + secPts(d, c, ids, 1) + secPts(d, c, ids, 2) + secPts(d, c, ids, 3) + secPts(d, c, ids, 4)
             + secPts(d, c, ids, 5) + secPts(d, c, ids, 6) + secPts(d, c, ids, 7) + secPts(d, c, ids, 8) + secPts(d, c, ids, 9);
      }

      allow get: if isAdmin() || hasPerm('learners.manage') || myPaper();
      allow list: if isAdmin() || hasPerm('learners.manage') || (signedIn() && resource.data.uid == request.auth.uid);

      // Start: today's id, inside the window, for the learner's own group, server-clock start.
      allow create: if signedIn()
        && quizWindowOpen()
        && id == request.auth.uid + '_' + string(istDay())
        && request.resource.data.keys().hasOnly(['uid', 'name', 'memberId', 'institution', 'day', 'group', 'code', 'picks', 'startedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day == istDay()
        && request.resource.data.group == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('quizGroup', '')
        && request.resource.data.startedAt == request.time
        && request.resource.data.code is string && request.resource.data.code.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && validQuizGroup(request.resource.data.group)
        && validPicks(request.resource.data.picks, request.resource.data.group);

      // 1) Hand in once, within 15 minutes (+60 s grace for slow networks); after that only a blank paper.
      // 2) Then, once each, the correct options (must match the hidden answer key) and the score.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && (
          (
            resource.data.get('submittedAt', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'submittedAt', 'timeTaken'])
            && request.resource.data.submittedAt == request.time
            && request.resource.data.timeTaken is int && request.resource.data.timeTaken >= 0 && request.resource.data.timeTaken <= 1200
            && validAnswers(request.resource.data.answers, resource.data.picks)
            && (
              request.time <= resource.data.startedAt + duration.value(960, 's')
              || allBlank(request.resource.data.answers)
            )
          )
          || (
            resource.data.get('submittedAt', null) != null
            && !('correct' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['correct'])
            && checkedKey(resource.data, request.resource.data.correct)
          )
          || (
            'correct' in resource.data
            && !('score' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score'])
            && checkedScore(resource.data, request.resource.data.score)
          )
        );

      // Admins can clear a paper so the learner can take today's quiz again.
      allow delete: if isAdmin();
    }

    // Best performer of each month, recorded by an admin: quizRewards/{YYYY-MM}.
    match /quizRewards/{month} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}
